      argument: Math.floor(Math.random()*20)+75,
      evidence: Math.floor(Math.random()*20)+70,
      procedure: Math.floor(Math.random()*20)+72,
      persuasion: Math.floor(Math.random()*20)+68
    };
    content.innerHTML = `
      <div class="grid grid-cols-2 gap-4 mb-4">
        <div><div class="text-xs text-slate-400 mb-1">Argument Strength</div><div class="h-2 bg-slate-800 rounded"><div class="h-2 bg-purple-500 rounded" style="width:${scores.argument}%"></div></div><div class="text-sm mt-1">${scores.argument}%</div></div>
        <div><div class="text-xs text-slate-400 mb-1">Evidence Usage</div><div class="h-2 bg-slate-800 rounded"><div class="h-2 bg-blue-500 rounded" style="width:${scores.evidence}%"></div></div><div class="text-sm mt-1">${scores.evidence}%</div></div>
        <div><div class="text-xs text-slate-400 mb-1">Procedural Accuracy</div><div class="h-2 bg-slate-800 rounded"><div class="h-2 bg-cyan-500 rounded" style="width:${scores.procedure}%"></div></div><div class="text-sm mt-1">${scores.procedure}%</div></div>
        <div><div class="text-xs text-slate-400 mb-1">Persuasiveness</div><div class="h-2 bg-slate-800 rounded"><div class="h-2 bg-pink-500 rounded" style="width:${scores.persuasion}%"></div></div><div class="text-sm mt-1">${scores.persuasion}%</div></div>
      </div>
      <div class="text-sm text-slate-300">
        <strong class="text-purple-400">AI Judge Notes:</strong> Strong opening with clear structure. Consider citing more recent precedent (post-2020). Your cross-examination technique needs refinement — avoid leading questions on direct. Overall performance: ${Math.round((scores.argument+scores.evidence+scores.procedure+scores.persuasion)/4)}%. Keep practicing!
      </div>`;
  }

  // LAWYERS DIRECTORY
  function renderStars(rating) {
    let html = '';
    for (let i = 1; i <= 5; i++) {
      html += i <= Math.round(rating) ? '<i class="fas fa-star rating-star"></i>' : '<i class="far fa-star rating-star-empty"></i>';
    }
    return html;
  }

  function renderLawyers() {
    const search = document.getElementById('lawyer-search').value.toLowerCase();
    const practice = document.getElementById('lawyer-practice').value;
    const location = document.getElementById('lawyer-location').value;
    const filtered = lawyers.filter(l => {
      const matchSearch = !search || l.name.toLowerCase().includes(search) || l.firm.toLowerCase().includes(search) || l.practice.toLowerCase().includes(search);
      const matchPractice = !practice || l.practice === practice;
      const matchLocation = !location || l.location === location;
      return matchSearch && matchPractice && matchLocation;
    });
    document.getElementById('lawyer-count').textContent = filtered.length;
    const grid = document.getElementById('lawyers-grid');
    grid.innerHTML = filtered.map(l => `
      <div class="lawyer-card">
        <div class="flex items-start gap-4 mb-4">
          <div class="w-14 h-14 rounded-full grad-bg flex items-center justify-center text-xl font-bold">${l.avatar}</div>
          <div class="flex-1">
            <div class="flex items-center gap-2">
              <h3 class="font-bold text-lg">${l.name}</h3>
              ${l.verified ? '<i class="fas fa-check-circle text-blue-400" title="Verified"></i>' : ''}
            </div>
            <div class="text-sm text-slate-400">${l.firm}</div>
            <div class="flex items-center gap-1 mt-1">${renderStars(l.rating)} <span class="text-xs text-slate-400 ml-1">${l.rating}</span></div>
          </div>
        </div>
        <div class="space-y-2 mb-4 text-sm">
          <div class="flex justify-between"><span class="text-slate-400">Practice Area</span><span>${l.practice}</span></div>
          <div class="flex justify-between"><span class="text-slate-400">Location</span><span><i class="fas fa-location-dot"></i> ${l.location}</span></div>
          <div class="flex justify-between"><span class="text-slate-400">Experience</span><span>${l.experience} years</span></div>
          <div class="flex justify-between"><span class="text-slate-400">Cases Won</span><span class="text-emerald-400">${l.cases}</span></div>
        </div>
        <div class="flex gap-2">
          <button onclick="alert('Consultation request sent to ${l.name}!')" class="btn btn-primary flex-1 text-sm"><i class="fas fa-calendar"></i> Consult</button>
          <button onclick="alert('Message sent to ${l.name}!')" class="btn btn-secondary text-sm"><i class="fas fa-envelope"></i></button>
        </div>
      </div>
    `).join('');
  }

  function filterLawyers() { renderLawyers(); }

  // Initialize
  window.addEventListener('load', () => {
    try { player = videojs('courtroom-player', { controls: true, autoplay: false, preload: 'auto', fluid: true }); } catch(e) { console.log('Video player init:', e); }
    showView('home');
  });
</script>
</body>
</html>

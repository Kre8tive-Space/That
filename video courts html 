    if (!input.value.trim()) return;
    const userMsg = input.value;
    body.innerHTML += `<div class="chat-bubble user">${userMsg}</div>`;
    input.value = '';
    body.scrollTop = body.scrollHeight;
    const lower = userMsg.toLowerCase();
    let response;
    if (lower.includes('alfai') || lower.includes('draft') || lower.includes('contract')) {
      response = `Alfai is our advanced AI legal suite. You can draft motions, review contracts, research cases, predict outcomes, and more. Head to the Alfai section to get started!`;
    } else if (lower.includes('mock') || lower.includes('trial') || lower.includes('practice')) {
      response = `Our Mock Trial Simulator lets you practice courtroom arguments against AI judges and opposing counsel. Choose from criminal, civil, family, or appellate scenarios.`;
    } else if (lower.includes('lawyer') || lower.includes('attorney') || lower.includes('find')) {
      response = `Our Lawyers Directory has 2,300+ verified attorneys. You can search by practice area, location, and rating. Visit the Lawyers section to browse.`;
    } else if (lower.includes('case') || lower.includes('cr-') || lower.includes('cv-')) {
      response = `For case "${userMsg.substring(0,30)}...", I recommend reviewing the file and preparing a Motion for Continuance if needed. Shall I draft it with Alfai?`;
    } else if (lower.includes('bail')) {
      response = `For bail bonding: submit your case details in the Bail section. Our licensed partners process requests 24/7 with an average 15-minute turnaround and 10% fee.`;
    } else {
      response = `I can help with cases, hearings, bail, Alfai tools, mock trials, or finding lawyers. What would you like to explore?`;
    }
    setTimeout(() => {
      body.innerHTML += `<div class="chat-bubble bot">${response}</div>`;
      body.scrollTop = body.scrollHeight;
    }, 700);
  }

  // ALFAI
  function openAlfaiTool(tool) {
    const prompts = {
      'draft': 'Motion for Continuance',
      'contract': 'Employment Agreement Review',
      'research': 'Search for similar cases',
      'predict': 'Analyze case outcome probability',
      'summarize': 'Summarize deposition transcript',
      'translate': 'Translate legal document to Spanish'
    };
    document.getElementById('alfai-prompt').value = prompts[tool] || '';
    document.getElementById('alfai-prompt').focus();
  }

  function runAlfai() {
    const prompt = document.getElementById('alfai-prompt').value;
    const docType = document.getElementById('alfai-doc-type').value;
    if (!prompt.trim()) {
      alert('Please enter case details or instructions.');
      return;
    }
    const output = document.getElementById('alfai-output');
    const content = document.getElementById('alfai-content');
    output.classList.remove('hidden');
    content.innerHTML = '<i class="fas fa-spinner fa-spin text-purple-400"></i> Alfai is generating your document...';
    output.scrollIntoView({behavior:'smooth'});

    setTimeout(() => {
      const generated = `IN THE UNITED STATES DISTRICT COURT
SOUTHERN DISTRICT OF NEW YORK
________________________________________

${docType.toUpperCase()}

Case No.: CR-2025-00421
________________________________________

COMES NOW the Defendant, by and through undersigned counsel, and respectfully moves this Court for an Order granting a continuance of the scheduled hearing date. In support thereof, Defendant states as follows:

1. This matter is currently scheduled for hearing on July 25, 2025.

2. Defendant requires additional time to complete discovery and review newly produced documents totaling approximately 15,000 pages.

3. Good cause exists for this continuance as the interests of justice require adequate preparation time.

4. This motion is made in good faith and not for purposes of delay.

WHEREFORE, Defendant respectfully requests that this Court grant a continuance of thirty (30) days and grant such other relief as the Court deems just and proper.

Respectfully submitted,
[ATTORNEY NAME]
[BAR NUMBER]
[FIRM NAME]
[CONTACT INFORMATION]

---
Generated by Alfai AI • ${new Date().toLocaleDateString()}
Confidence Score: 94% • Citations Verified: 12`;
      content.textContent = generated;
    }, 1500);
  }

  function copyAlfaiOutput() {
    const text = document.getElementById('alfai-content').textContent;
    navigator.clipboard.writeText(text).then(() => alert('Copied to clipboard!'));
  }

  function downloadAlfaiOutput() {
    const text = document.getElementById('alfai-content').textContent;
    const blob = new Blob([text], {type:'text/plain'});
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'alfai-generated-document.txt';
    a.click();
    URL.revokeObjectURL(url);
  }

  // MOCK TRIAL
  function startMockTrial(scenario) {
    currentMockScenario = scenario;
    const titles = {criminal:'Criminal Defense — State v. Johnson', civil:'Civil Litigation — Smith v. Acme Corp', family:'Family Law — Doe v. Doe Custody', appeal:'Appellate Argument — Case #2024-1847'};
    document.getElementById('mock-title').textContent = titles[scenario];
    document.getElementById('mock-trial-active').classList.remove('hidden');
    document.getElementById('mock-feedback').classList.add('hidden');
    document.getElementById('mock-argument').value = '';
    mockSeconds = 0;
    updateMockTimer();
    clearInterval(mockTimerInterval);
    mockTimerInterval = setInterval(() => { mockSeconds++; updateMockTimer(); }, 1000);
    document.getElementById('mock-trial-active').scrollIntoView({behavior:'smooth'});
  }

  function updateMockTimer() {
    const m = Math.floor(mockSeconds / 60).toString().padStart(2,'0');
    const s = (mockSeconds % 60).toString().padStart(2,'0');
    document.getElementById('mock-timer').textContent = `${m}:${s}`;
  }

  function endMockTrial() {
    clearInterval(mockTimerInterval);
    if (confirm('End this mock trial session?')) {
      document.getElementById('mock-trial-active').classList.add('hidden');
    }
  }

  function submitMockArgument() {
    const arg = document.getElementById('mock-argument').value;
    if (!arg.trim()) { alert('Please enter your argument.'); return; }
    const prompts = {
      criminal: 'Counsel, your argument raises interesting points. However, the prosecution notes that the defendant was identified by two witnesses. How do you address the credibility of eyewitness testimony in this case?',
      civil: 'Thank you, Counsel. The defense argues the contract contained a force majeure clause. How do you respond to this affirmative defense?',
      family: 'The court appreciates your presentation. The opposing party claims superior financial stability. How does this serve the best interest of the child?',
      appeal: 'Counsel, your argument relies heavily on Smith v. Jones (2019). However, the appellee distinguishes that case on its facts. Please explain why precedent applies here.'
    };
    document.getElementById('mock-judge-prompt').textContent = prompts[currentMockScenario];
    document.getElementById('mock-argument').value = '';
  }

  function getMockFeedback() {
    const feedback = document.getElementById('mock-feedback');
